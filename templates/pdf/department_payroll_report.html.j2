<!DOCTYPE html>
<html lang="ru">
<head>
<meta charset="UTF-8">
<style>
  * { margin: 0; padding: 0; box-sizing: border-box; }
  body { font-family: Arial, sans-serif; font-size: 12px; color: #1a1a1a; padding: 24px; }
  h1 { font-size: 16px; margin-bottom: 4px; }
  .subtitle { color: #555; margin-bottom: 20px; }
  .meta { display: flex; gap: 32px; margin-bottom: 20px; background: #f5f5f5; padding: 12px; border-radius: 4px; }
  .meta div .label { color: #555; font-size: 11px; }
  .meta div .value { font-weight: bold; font-size: 13px; }
  table { width: 100%; border-collapse: collapse; }
  th { background: #f0f0f0; text-align: left; padding: 7px 8px; border-bottom: 2px solid #ccc; font-size: 11px; text-transform: uppercase; color: #444; }
  td { padding: 7px 8px; border-bottom: 1px solid #e5e5e5; }
  tr:hover td { background: #fafafa; }
  .amount { text-align: right; font-variant-numeric: tabular-nums; }
  .accrual { color: #2b7a2b; }
  .deduction { color: #c0392b; }
  tfoot td { font-weight: bold; background: #f0f0f0; border-top: 2px solid #ccc; }
  @page { size: A4 landscape; margin: 16mm; }
  @media print { body { padding: 0; } }
</style>
</head>
<body>

<h1>Отчёт по подразделению: {{ department_name }}</h1>
<div class="subtitle">Код: {{ department_code }}</div>

<div class="meta">
  <div>
    <div class="label">Период с</div>
    <div class="value">{{ period_from or '—' }}</div>
  </div>
  <div>
    <div class="label">Период по</div>
    <div class="value">{{ period_to or '—' }}</div>
  </div>
  <div>
    <div class="label">Сотрудников</div>
    <div class="value">{{ employee_count }}</div>
  </div>
</div>

<table>
  <thead>
    <tr>
      <th>Табельный №</th>
      <th>ФИО</th>
      <th>Должность</th>
      <th class="amount">Оклад</th>
      <th class="amount">Начислено</th>
      <th class="amount">Удержано</th>
      <th class="amount">К выплате</th>
    </tr>
  </thead>
  <tbody>
    {% for emp in employees %}
    <tr>
      <td>{{ emp.employee_code }}</td>
      <td>{{ emp.employee_full_name }}</td>
      <td>{{ emp.position_name }}</td>
      <td class="amount">{{ "%.2f"|format(emp.base_salary|float) }} ₽</td>
      <td class="amount accrual">{{ "%.2f"|format(emp.accruals_sum|float) }} ₽</td>
      <td class="amount deduction">{{ "%.2f"|format(emp.deductions_sum|float) }} ₽</td>
      <td class="amount"><strong>{{ "%.2f"|format(emp.net_salary|float) }} ₽</strong></td>
    </tr>
    {% endfor %}
  </tbody>
  <tfoot>
    <tr>
      <td colspan="3">Итого</td>
      <td class="amount">{{ "%.2f"|format(total_base_salary|float) }} ₽</td>
      <td class="amount accrual">{{ "%.2f"|format(total_accruals|float) }} ₽</td>
      <td class="amount deduction">{{ "%.2f"|format(total_deductions|float) }} ₽</td>
      <td class="amount">{{ "%.2f"|format(total_net_salary|float) }} ₽</td>
    </tr>
  </tfoot>
</table>

</body>
</html>
